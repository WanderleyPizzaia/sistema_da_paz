# Copie para .env e ajuste os valores. NUNCA comite o .env real.

# Banco de dados PostgreSQL.
# Local (via docker compose): postgresql://paz:paz@localhost:5432/paz?schema=public
# Produção (EasyPanel): use a string de conexão interna do serviço Postgres.
DATABASE_URL="postgresql://paz:paz@localhost:5432/paz?schema=public"

# Em modo local/teste, mostra o código de login na tela.
# Em produção, deixe "false".
LOGIN_CODES_VISIVEIS="true"

# Usados pelo seed de produção (cria o primeiro administrador).
ADMIN_NOME="Administrador"
ADMIN_WHATSAPP="11999990000"

# Envio do código de login pelo WhatsApp (Evolution API).
# Deixe em branco para não enviar (código só na tela/log).
EVOLUTION_API_URL="http://evolution-api:8080"
EVOLUTION_API_KEY="sua-chave-global-da-evolution"
EVOLUTION_INSTANCE="rede-paz"
